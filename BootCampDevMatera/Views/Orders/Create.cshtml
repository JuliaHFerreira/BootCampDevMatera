@model BootCampDevMatera.Views.Orders.OrderFormViewModel

@{
    ViewData["Title"] = "Pedido";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="@ViewContext.RouteData.Values["action"]">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="Id" type="hidden" />

    <div class="form-group">
        <label asp-for="DateOrder" class="control-label">Data do Pedido</label>
        <input asp-for="DateOrder" type="date" class="form-control" />
        <span asp-validation-for="DateOrder" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IdClient" class="control-label">Cliente</label>
        <select asp-for="IdClient" class="form-control" asp-items="ViewBag.IdClient"></select>
        <span asp-validation-for="IdClient" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IdSeller" class="control-label">Vendedor</label>
        <select asp-for="IdSeller" class="form-control" asp-items="ViewBag.IdSeller"></select>
        <span asp-validation-for="IdSeller" class="text-danger"></span>
    </div>

    <hr />
    <h4>Itens do Pedido</h4>

    @for (int i = 0; i < Model.Itens.Count; i++)
    {
        <div class="row mb-3 item-row">
            <div class="col-md-6">
                <label class="control-label">Produto</label>
                <input asp-for="Itens[i].ProductCode" class="form-control product-code" list="productsList" />
                <span asp-validation-for="Itens[i].ProductCode" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="control-label">Quantidade</label>
                <input asp-for="Itens[i].Quantity" class="form-control quantity" />
                <span asp-validation-for="Itens[i].Quantity" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="control-label">Valor do Item</label>
                <input asp-for="Itens[i].Value" class="form-control item-value" readonly />
            </div>
        </div>
    }

    <datalist id="productsList">
        @foreach (var product in ViewBag.Products)
        {
            <option value="@product.Code">@product.Display</option>
        }
    </datalist>

    <div class="form-group mt-3">
        <label asp-for="Value" class="control-label">Valor Total</label>
        <input asp-for="Value" class="form-control" id="order-total" readonly />
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Salvar" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const products = {};

        @foreach (var product in ViewBag.Products)
        {
            <text>
                products["@product.Code"] = @product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture);
            </text>
        }

        function parseNumber(value) {
            if (!value) return 0;
            return parseFloat(value.toString().replace(",", ".")) || 0;
        }

        function formatNumber(value) {
            return value.toFixed(2).replace(".", ",");
        }

        function recalculateOrder() {
            let total = 0;

            document.querySelectorAll(".item-row").forEach(function (row) {
                const productCodeInput = row.querySelector(".product-code");
                const quantityInput = row.querySelector(".quantity");
                const itemValueInput = row.querySelector(".item-value");

                const code = productCodeInput.value.trim();
                const quantity = parseNumber(quantityInput.value);
                const price = products[code] || 0;

                const itemValue = quantity * price;

                itemValueInput.value = formatNumber(itemValue);
                total += itemValue;
            });

            const totalInput = document.getElementById("order-total");
            if (totalInput) {
                totalInput.value = formatNumber(total);
            }
        }

        document.addEventListener("input", function (e) {
            if (e.target.classList.contains("product-code") || e.target.classList.contains("quantity")) {
                recalculateOrder();
            }
        });

        document.addEventListener("change", function (e) {
            if (e.target.classList.contains("product-code") || e.target.classList.contains("quantity")) {
                recalculateOrder();
            }
        });

        window.addEventListener("load", recalculateOrder);
    </script>
}
